{
    "name": "nbl-highligher",
    "displayName": "NBL Highligher",
    "description": "Provides highlighting (and nothing else!) for Lua/Luau",
    "keywords": [
        "Luau",
        "Grammar"
    ],
    "version": "2.0.1",
    "repository": {
        "type": "git",
        "url": "https://github.com/user-with-username/nbl-highligher"
    },
    "bugs": {
        "url": "https://github.com/user-with-username/nbl-highligher/issues"
    },
    "license": "MIT",
    "publisher": "user-with-username",
    "engines": {
        "vscode": "^1.48.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "luau",
                "aliases": [
                    "Luau"
                ],
                "extensions": [
                    ".lua",
                    ".luau"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "luau",
                "scopeName": "source.lua",
                "path": "./syntaxes/lua.tmLanguage.json"
            }
        ]
    }
}